<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native startup must not choose Dark from the OS before Flutter hydrates
         the independently saved app theme. No text or locale is shown here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/aw_launch_surface</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/aw_launch_surface</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
