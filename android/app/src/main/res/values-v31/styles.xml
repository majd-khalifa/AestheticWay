<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses its own splash surface before the Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/aw_launch_surface</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/aw_launch_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/aw_launch_surface</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
